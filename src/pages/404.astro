            max-width: 600px;
            opacity: 1;
            overflow: hidden;
            position: relative;
            top: 0;
            z-index: 2;
        }
        .offline .controller {
            background: rgba(247, 247, 247, 0.1);
            height: 100vh;
            left: 0;
            position: relative;
            top: 0;
            width: 100vw;
            height: 50vw;
            z-index: 1;
            padding: 0;
            margin: 0;
        }
        #offline-resources {
            display: none;
        }
        @media (max-width: 420px) {
            .suggested-left > #control-buttons,
            .suggested-right > #control-buttons {
                float: none;
            }
