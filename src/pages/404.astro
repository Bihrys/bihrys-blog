                url(/dinorun/200-error-offline.png) 2x
            );
            position: relative;
        }
        .hidden {
            display: none;
        }
        /* Offline page */
        .offline .interstitial-wrapper {
            color: #2b2b2b;
            font-size: 1em;
            line-height: 1.55;
